    {
      "name": "Stockout rate by lead time",
      "original_card_id": 49,
      "dataset_query": {
        "database": 2,
        "lib/type": "mbql/query",
        "stages": [
          {
            "lib/type": "mbql.stage/native",
            "native": "select sp.supplier_lead_time as supplier_lead_time_days,\n       count(*) as sales_events,\n       count(*) filter (where f.stockout_indicator) as stockout_events,\n       round(100.0 * count(*) filter (where f.stockout_indicator) / nullif(count(*), 0), 2)\n           as stockout_rate_pct\nfrom fct_walmart_sales f\njoin dim_supplier sp on f.supplier_key = sp.supplier_key\ngroup by sp.supplier_lead_time\norder by sp.supplier_lead_time",
            "template-tags": []
          }
        ]
      },
      "display": "line",
      "displayIsLocked": true,
      "parameters": [],
      "type": "question",
      "visualization_settings": {
        "graph.dimensions": [
          "supplier_lead_time_days"
        ],
        "graph.metrics": [
          "stockout_rate_pct"
        ],
        "graph.x_axis.title_text": "Supplier lead time (days)",
        "graph.y_axis.title_text": "Stockout rate (%)",
        "graph.show_values": true,
        "graph.label_value_formatting": "compact",
        "series_settings": {
          "stockout_rate_pct": {
            "color": "#F2A86F"
          }
        },
        "column_settings": {
          "[\"name\",\"stockout_rate_pct\"]": {
            "decimals": 1,
            "suffix": "%"
          }
        }
      }
    },
    {
      "name": "Stockout rate | holiday vs normal",
      "original_card_id": 50,
      "dataset_query": {
        "database": 2,
        "lib/type": "mbql/query",
        "stages": [
          {
            "lib/type": "mbql.stage/native",
            "native": "select case when d.holiday_indicator then 'Holiday' else 'Normal day' end as day_type,\n       count(*) as sales_events,\n       count(*) filter (where f.stockout_indicator) as stockout_events,\n       round(100.0 * count(*) filter (where f.stockout_indicator) / nullif(count(*), 0), 2)\n           as stockout_rate_pct\nfrom fct_walmart_sales f\njoin dim_date d on f.date_key = d.date_key\ngroup by d.holiday_indicator\norder by d.holiday_indicator",
            "template-tags": []
          }
        ]
      },
      "display": "bar",
      "displayIsLocked": true,
      "parameters": [],
      "type": "question",
      "visualization_settings": {
        "graph.dimensions": [
          "day_type"
        ],
        "graph.metrics": [
          "stockout_rate_pct"
        ],
        "graph.x_axis.title_text": "Day type",
        "graph.y_axis.title_text": "Stockout rate (%)",
        "graph.show_values": true,
        "graph.label_value_formatting": "compact",
        "series_settings": {
          "stockout_rate_pct": {
            "color": "#EF8C8C"
          }
        },
        "column_settings": {
          "[\"name\",\"stockout_rate_pct\"]": {
            "decimals": 1,
            "suffix": "%"
          }
        }
      }
    },
