    {
      "name": "Units per bill by promotion",
      "original_card_id": 45,
      "dataset_query": {
        "database": 2,
        "lib/type": "mbql/query",
        "stages": [
          {
            "lib/type": "mbql.stage/native",
            "native": "select promotion_type,\n       round(sum(quantity_sold)::numeric / nullif(count(distinct transaction_id), 0), 2)\n           as units_per_transaction\nfrom fct_walmart_sales\ngroup by promotion_type\norder by units_per_transaction",
            "template-tags": []
          }
        ]
      },
      "display": "bar",
      "displayIsLocked": true,
      "parameters": [],
      "type": "question",
