            "lib/type": "mbql.stage/native",
            "native": "select make_date(year, month_number, 1) as month, total_revenue\nfrom smt_sales_summary\nwhere time_grain = 'month' and dimension_grain = 'all_dimensions' and year = 2024\norder by month",
