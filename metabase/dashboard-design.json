    {
      "name": "Spending & income by membership",
      "original_card_id": 47,
      "dataset_query": {
        "database": 2,
        "lib/type": "mbql/query",
        "stages": [
          {
            "lib/type": "mbql.stage/native",
            "native": "select c.customer_loyalty_level,\n       sum(f.total_amount) as \"Total spending\",\n       round(avg(c.customer_income), 2) as \"Avg. income\"\nfrom fct_walmart_sales f\njoin dim_customer c on f.customer_key = c.customer_key\ngroup by c.customer_loyalty_level\norder by case c.customer_loyalty_level\n    when 'Bronze' then 1 when 'Silver' then 2 when 'Gold' then 3 when 'Platinum' then 4\nend",
            "template-tags": []
          }
        ]
      },
      "display": "combo",
      "displayIsLocked": true,
      "parameters": [],
      "type": "question",
      "visualization_settings": {
        "graph.dimensions": [
          "customer_loyalty_level"
        ],
        "graph.metrics": [
          "Total spending",
          "Avg. income"
        ],
        "graph.x_axis.title_text": "Membership tier",
        "graph.y_axis.title_text": "Spending / income (USD)",
        "graph.show_values": false,
        "graph.label_value_formatting": "compact",
        "series_settings": {
          "Total spending": {
            "color": "#509EE3"
          },
          "Avg. income": {
            "color": "#999AC4"
          }
        }
      }
    },
